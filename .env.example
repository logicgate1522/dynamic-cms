# Copy this file to .env and fill in real values.
# Nothing in this file is read automatically in production — these are
# consumed via os.getenv() in backend/settings.py, with safe generic
# fallbacks for local development only.

# ==================== Core ====================

# Leave unset (or False) in production. Only set to True for local dev.
DEBUG=True

# Required in production (DEBUG=False) — app refuses to start without it.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated. Must include your real domain(s) in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# ==================== CORS / CSRF ====================
# Comma-separated. Must include your real frontend origin(s) in production.

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# ==================== Database ====================
# Leave unset for local dev — falls back to SQLite automatically when
# DEBUG=True. Set DATABASE_URL (preferred) or the POSTGRES_* vars below
# for production.

# DATABASE_URL=postgres://user:password@host:5432/dbname
# POSTGRES_DB=app
# POSTGRES_USER=app
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer

# ==================== Email ====================
# Defaults to printing emails to the console. Set real SMTP creds to
# actually send mail (form notifications, etc).

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Where new form submissions get emailed. Leave empty to skip notification
# emails entirely (submissions still save to the database either way).
FORM_NOTIFICATION_EMAIL=

# ==================== Cache / throttling ====================
# Leave unset for a single-process/dev deploy — falls back to an in-memory
# cache automatically. Set this once you have Redis available, especially
# if running multiple gunicorn workers (throttle counts aren't shared
# across workers without it).

# REDIS_URL=redis://localhost:6379/0

THROTTLE_RATE_ANON=120/minute
THROTTLE_RATE_USER=300/minute
THROTTLE_RATE_FORM_SUBMIT=5/minute
THROTTLE_RATE_LOGIN=10/minute
THROTTLE_RATE_RESOLVE=60/minute

# ==================== Misc ====================

TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
PAGE_SIZE=20

# ==================== Security / uploads ====================
# Set True only when running behind a TLS-terminating proxy.
SECURE_PROXY_SSL_HEADER=False
# Image upload limits.
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_DIMENSION=12000
# SVG uploads are a script-injection vector — off by default.
ALLOW_SVG_UPLOAD=False

# ==================== Sitemap ====================
# Extra content sources: comma-separated "module.path:callable" entries.
# "pages" and "blog" are always included.
SITEMAP_SOURCES=

# ==================== Frontend cache refresh ====================
# Every content write POSTs the changed cache tags to the frontend, signed
# with REVALIDATE_SECRET (same value in the frontend's env). Leave the URL
# empty to disable. Generate a secret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Admin browser session lifetime in seconds (default 12 hours).
SESSION_COOKIE_AGE=43200
# Production cookies are SameSite=Strict, which works when the API shares the
# frontend's site (api.example.com + www.example.com). For an API on another
# domain set SESSION_COOKIE_SAMESITE=None together with SESSION_COOKIE_SECURE=True.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# SESSION_COOKIE_SAMESITE=

# Re-encode uploaded photos to WebP (only when smaller), capped at this size.
IMAGE_OPTIMIZE=True
IMAGE_OPTIMIZE_MAX_DIMENSION=2400
IMAGE_OPTIMIZE_WEBP_QUALITY=82

# ---- Tracking (R31–R33): see LAUNCH_GUIDE.md ----
# Encrypts stored tool credentials. Generate:
#   ./venv/bin/python -c "from api.crypto import generate_key; print(generate_key())"
TRACKING_SECRET_KEY=
# TRACKING_SECRET_KEY_OLD=            # only while rotating (manage.py tracking_rotate_key)
# TRACKING_ALERT_EMAIL=               # alerts via backend SMTP (defaults to FORM_NOTIFICATION_EMAIL)
# TRACKING_ALERT_WEBHOOK=             # alerts as JSON {text} to Slack/Teams/any webhook
# TRACKING_INLINE_DELIVERY=True       # also send server events right away (worker retries either way)
# TRUST_GEO_HEADERS=True              # read CDN location headers (Cloudflare, Vercel…)
# GEOIP_DB_PATH=                      # optional MaxMind GeoLite2-City.mmdb (pip install geoip2)
# THROTTLE_RATE_EVENTS=60/minute
